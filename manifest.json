{
  "manifest_version": 3,
  "name": "My Shorts Blocker",
  "version": "1.0.0",
  "description": "Hides YouTube Shorts and redirects Shorts links to the normal player.",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
